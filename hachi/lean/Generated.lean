def ntt.gold_add (a : Std.U64) (b : Std.U64) : Result Std.U64 := do
  let i ← lift (UScalar.cast .U128 a)
  let i1 ← lift (UScalar.cast .U128 b)
  let s ← i + i1
  let p ← lift (UScalar.cast .U128 ntt.GOLD_P)
  if s >= p
