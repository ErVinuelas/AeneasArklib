  let e2 ← cpoly.field.Ext4.Insts.CoreOpsArithMulExt4Ext4.mul eq_all e1
  let e3 ← sumcheck.RoundStatement.impl.target_zero stmt
  let b ← cpoly.field.Ext4.Insts.CoreCmpPartialEqExt4.eq e2 e3
  if b
