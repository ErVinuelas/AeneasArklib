  (w : ringswitch.LiftedWitness) (size : Std.Usize) (zero : Bool)
  (i : Std.Usize) :
  Result (ControlFlow (Bool × Std.Usize) Bool)
  := do
  if i < size
  then
    let e ← zerocheck.h_alpha_evals s alpha w i
    let b ← cpoly.field.Ext4.is_zero e
    let zero1 ← if b
                  then ok zero
                  else ok false
    let i1 ← i + 1#usize
    ok (cont (zero1, i1))
  else ok (done zero)

