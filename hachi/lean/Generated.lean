def ntt.gold_sub (a : Std.U64) (b : Std.U64) : Result Std.U64 := do
  if a >= b
  then a - b
  else
    let i ← lift (UScalar.cast .U128 a)
    let i1 ← lift (UScalar.cast .U128 ntt.GOLD_P)
    let i2 ← i + i1
