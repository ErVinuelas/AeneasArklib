  := do
  let pm ← ringswitch.RlinStatement.impl.m s
  let mu ← linalg.PolyMatrix.cols pm
  let rows ← linalg.PolyMatrix.rows pm
  if u < mu
  then
    let pv ← linalg.PolyMatrix.row pm i
    let r ← linalg.PolyVec.get pv u
